{
    "name": "gupalo/browser-notifier",
    "description": "Extension of Symfony Notifier for browsers",
    "type": "library",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "psr/log": ">=3.0",
        "symfony/notifier": "^7.4|^8.0",
        "twig/twig": "^3.22"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "config": {
        "preferred-install": {
            "*": "dist"
        },
        "platform": {
            "php": "8.4"
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Gupalo\\BrowserNotifier\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gupalo\\BrowserNotifier\\Tests\\": "tests/"
        }
    }
}
